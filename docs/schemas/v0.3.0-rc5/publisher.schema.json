{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moid.info/schemas/v0.3.0-rc5/publisher.schema.json",
  "title": "MoID Publisher Namespace Binding (.well-known/moid-publisher.json) v0.3.0-rc5",
  "type": "object",
  "required": [
    "spec_version", "serial", "namespace", "domain",
    "namespace_claim", "updated_at", "expires_at", "allowed_identities"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "spec_version": { "const": "0.3.0-rc5" },
    "serial": { "type": "integer", "minimum": 1 },
    "namespace": { "$ref": "common.schema.json#/$defs/namespaceSlug" },
    "domain": { "type": "string", "format": "hostname", "minLength": 3, "pattern": "\\." },
    "display_name": { "type": "string", "minLength": 1 },
    "namespace_claim": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["domain_exact", "platform_bidirectional", "policy_pinned"] },
        "platform_proof_uri": { "type": "string", "format": "uri" }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["mode"], "properties": { "mode": { "const": "platform_bidirectional" } } },
          "then": { "type": "object", "required": ["platform_proof_uri"], "properties": { "platform_proof_uri": true } }
        }
      ],
      "unevaluatedProperties": false
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "dns_txt_anchor": { "type": "string", "minLength": 3 },
    "repositories": { "type": "array", "items": { "type": "string", "format": "uri" }, "uniqueItems": true },
    "allowed_identities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/identity" }
    },
    "revoked_identities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identity", "revoked_at"],
        "properties": {
          "identity": { "$ref": "common.schema.json#/$defs/identity" },
          "revoked_at": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "enum": ["key_compromise", "superseded", "cessation_of_operation", "affiliation_changed", "unspecified"] }
        },
        "unevaluatedProperties": false
      }
    },
    "binding_signature": {
      "type": "object",
      "required": ["format", "path"],
      "properties": {
        "format": { "type": "string", "enum": ["pgp-detached-v1", "ssh-sig-v1", "minisign-v1", "dsse-in-toto-v1", "sigstore-bundle-v0.3"] },
        "path": { "type": "string", "minLength": 1 }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
