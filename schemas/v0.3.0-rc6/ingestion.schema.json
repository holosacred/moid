{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moid.info/schemas/v0.3.0-rc6/ingestion.schema.json",
  "title": "MoID Ingestion Catalog Record v0.3.0-rc6",
  "type": "object",
  "required": ["record_id", "record_level", "source_category", "modalities", "license_status"],
  "patternProperties": { "^x-": {} },
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "parent_record_id": { "type": "string", "minLength": 1 },
    "record_level": { "type": "string", "enum": ["corpus", "dataset", "crawl_snapshot", "shard", "document"] },
    "source_category": { "type": "string", "enum": ["public_dataset", "private_dataset", "web_crawl", "user_data", "synthetic"] },
    "locator": { "type": "string", "format": "uri" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "digest": { "$ref": "common.schema.json#/$defs/digest" },
    "digest_scope": { "type": "string", "enum": ["raw_bytes", "processed_bytes", "tokenized_bytes"] },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/modality" }
    },
    "token_count": { "type": "integer", "minimum": 0 },
    "sample_count": { "type": "integer", "minimum": 0 },
    "epochs": { "type": "number", "minimum": 0 },
    "sampling_weight": { "type": "number", "minimum": 0, "maximum": 1 },
    "split": { "type": "string", "enum": ["pretrain", "midtrain", "sft", "distillation", "alignment", "eval"] },
    "domain_tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "top_domains": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "license_status": { "type": "string", "enum": ["spdx", "custom", "public_domain", "mixed", "unlicensed", "unknown"] },
    "spdx_expression": { "type": "string", "minLength": 1 },
    "rights_reservations": {
      "type": "object",
      "properties": {
        "robots_txt_policy": { "type": "string" },
        "tdm_opt_out_protocol": { "type": "string" },
        "filtering_notes": { "type": "string" },
        "observed_at": { "type": "string", "format": "date" }
      },
      "unevaluatedProperties": false
    },
    "synthetic": {
      "type": "object",
      "required": ["is_synthetic"],
      "properties": {
        "is_synthetic": { "type": "boolean" },
        "generator_ref": { "$ref": "common.schema.json#/$defs/externalTargetRef" },
        "curation_method": { "type": "string" }
      },
      "unevaluatedProperties": false
    },
    "processing_summary": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["license_status"], "properties": { "license_status": { "const": "spdx" } } },
      "then": { "type": "object", "required": ["spdx_expression"], "properties": { "spdx_expression": true } }
    },
    {
      "if": { "type": "object", "required": ["digest"], "properties": { "digest": true } },
      "then": { "type": "object", "required": ["digest_scope"], "properties": { "digest_scope": true } }
    },
    {
      "if": { "type": "object", "required": ["record_level"], "properties": { "record_level": { "enum": ["shard", "document"] } } },
      "then": { "type": "object", "required": ["digest", "digest_scope"], "properties": { "digest": true, "digest_scope": true } }
    }
  ],
  "unevaluatedProperties": false
}
