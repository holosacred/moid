{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moid.info/schemas/v0.3.0-rc4/publisher.schema.json",
  "title": "MoID Publisher Namespace Binding (.well-known/moid-publisher.json) v0.3.0-rc4",
  "type": "object",
  "required": ["spec_version", "namespace", "domain", "allowed_identities", "updated_at"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "spec_version": { "const": "0.3.0-rc4" },
    "namespace": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "domain": { "type": "string", "minLength": 3 },
    "display_name": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "dns_txt_anchor": { "type": "string", "description": "Optional _moid.<domain> TXT host anchoring this binding's JCS digest." },
    "repositories": { "type": "array", "items": { "type": "string", "format": "uri" }, "uniqueItems": true },
    "allowed_identities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/identity" }
    },
    "revoked_identities": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/identity" }
    },
    "binding_signature": {
      "type": "object",
      "description": "Optional detached signature (e.g., GPG .asc, SSH .sig, Sigstore bundle) over this file's RFC 8785 JCS bytes.",
      "required": ["format", "path"],
      "properties": {
        "format": { "enum": ["pgp-detached-v1", "ssh-sig-v1", "dsse-in-toto-v1", "sigstore-bundle-v0.3"] },
        "path": { "type": "string", "minLength": 1 }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
